<%# Redmine Issue Merge plugin (Apache-2.0, see LICENSE and NOTICE) %>
<% s = RedmineIssueMerge::DEFAULTS.merge(settings.to_h.transform_keys(&:to_s)) %>
<% closed = IssueStatus.where(is_closed: true).sorted.map { |status| [status.name, status.id.to_s] } %>

<p>
  <label for="settings_source_action"><%= l(:setting_issue_merge_source_action) %></label>
  <%= select_tag 'settings[source_action]',
                 options_for_select([[l(:label_issue_merge_action_close), 'close'],
                                     [l(:label_issue_merge_action_delete), 'delete']], s['source_action']),
                 id: 'settings_source_action' %>
</p>
<p>
  <label for="settings_closed_status_id"><%= l(:setting_issue_merge_closed_status) %></label>
  <%= select_tag 'settings[closed_status_id]',
                 options_for_select([[l(:label_issue_merge_first_closed_status), '']] + closed,
                                    s['closed_status_id'].to_s),
                 id: 'settings_closed_status_id' %>
</p>
<% %w[escalate_priority fill_custom_fields add_watchers notify].each do |key| %>
  <p>
    <label for="settings_<%= key %>"><%= l(:"setting_issue_merge_#{key}") %></label>
    <%= hidden_field_tag "settings[#{key}]", '0', id: nil %>
    <%= check_box_tag "settings[#{key}]", '1', s[key].to_s == '1', id: "settings_#{key}" %>
  </p>
<% end %>
<p>
  <label for="settings_protected_pattern"><%= l(:setting_issue_merge_protected_pattern) %></label>
  <%= text_field_tag 'settings[protected_pattern]', s['protected_pattern'], size: 60,
                     id: 'settings_protected_pattern' %>
  <% if s['protected_pattern'].present? && RedmineIssueMerge.protected_regexp.nil? %>
    <span class="error"><%= l(:error_issue_merge_invalid_pattern) %></span>
  <% end %>
  <em class="info"><%= l(:text_issue_merge_protected_pattern_info) %></em>
</p>
